# Server Port & Environment
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=your_mongodb_connection_string_here

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_random_string_here
JWT_EXPIRES_IN=7d

# Firebase Cloud Storage (Optional - Local Encrypted Vault fallback is used if omitted)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
